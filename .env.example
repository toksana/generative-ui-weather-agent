# Open-Meteo API hosts. Both default to the public Open-Meteo endpoints and
# work out of the box — only set these to point at a self-hosted mirror, a
# staging host, or to redirect requests during a fallback drill.
# OPEN_METEO_BASE_URL=https://api.open-meteo.com
# OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
